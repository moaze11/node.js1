# Copier en .env et remplir. Ne jamais commiter le vrai .env.
DATABASE_URL="file:./dev.db"
PORT=3002

# Au moins 32 caractères, différents l'un de l'autre (ex : openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Emails (Resend)
RESEND_API_KEY=
APP_URL=http://localhost:3002

# IA de triage des tickets (OpenAI). Sans clé, les tickets sont créés sans réponse IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
